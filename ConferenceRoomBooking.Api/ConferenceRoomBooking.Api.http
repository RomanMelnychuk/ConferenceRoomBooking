@ConferenceRoomBooking.Api_HostAddress = http://localhost:5062

### Get all rooms (expect 200)
GET {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms

### Room not found (expect 404)
GET {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms/999

### Create room (expect 201)
POST {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Room D",
  "capacity": 20,
  "basePricePerHour": 1000,
  "serviceIds": [1, 2]
}

### Invalid data (expect 400 with validation errors)
POST {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "",
  "capacity": 0,
  "basePricePerHour": 1000,
  "serviceIds": []
}

### Unknown service (expect 400 "Services not found: 99")
POST {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Room E",
  "capacity": 20,
  "basePricePerHour": 1000,
  "serviceIds": [99]
}

### Update room: new price + add Sound, like in the task (expect 200)
PUT {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms/4
Content-Type: application/json

{
  "name": "Room D",
  "capacity": 20,
  "basePricePerHour": 2500,
  "serviceIds": [1, 2, 3]
}

### Delete room (expect 204)
DELETE {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms/4

### Search available rooms (expect Room A and Room B, Room C is too small)
GET {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms/available?date=2026-10-01&startTime=10:00&endTime=14:00&capacity=50

### Search outside working hours (expect 400)
GET {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms/available?date=2026-10-01&startTime=05:00&endTime=08:00&capacity=10

### Search in the past, date from the task example (expect 400)
GET {{ConferenceRoomBooking.Api_HostAddress}}/api/rooms/available?date=2024-09-01&startTime=10:00&endTime=14:00&capacity=50